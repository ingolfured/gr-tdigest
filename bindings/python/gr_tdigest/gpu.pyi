import numpy as np
import numpy.typing as npt

from . import TDigest

def from_array(values: DeviceArray, weights: DeviceArray | None = ..., **options: object) -> GpuDigest: ...

class DeviceArray:
    @property
    def device(self) -> int: ...
    def __init__(self, values: npt.NDArray[np.float64], device: int = ...) -> None: ...
    def to_numpy(self) -> npt.NDArray[np.float64]: ...

class GpuDigest:
    def merged(self, other: GpuDigest) -> GpuDigest: ...
    @staticmethod
    def merge_all(digests: list[GpuDigest], device: int | None = ...) -> GpuDigest: ...
    @staticmethod
    def merge_groups(groups: list[list[GpuDigest]], device: int | None = ...) -> list[GpuDigest]: ...
    @staticmethod
    def from_bytes(data: bytes, device: int = ...) -> GpuDigest: ...
    def add(self, values: DeviceArray, weights: DeviceArray | None = ...) -> None: ...
    def to_bytes(self) -> bytes: ...
    def cdf_device(self, probes: DeviceArray) -> DeviceArray: ...
    def quantile_device(self, probabilities: DeviceArray) -> DeviceArray: ...
    def __init__(self, digest: TDigest, device: int = ...) -> None: ...
    def quantile(self, probabilities: npt.NDArray[np.float64]) -> npt.NDArray[np.float64]: ...
    def median(self) -> float: ...
    def cdf(self, probes: npt.NDArray[np.float64]) -> npt.NDArray[np.float64]: ...
