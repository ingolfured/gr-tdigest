from enum import Enum
from typing import Any, Iterable, Literal, Sequence, overload

import numpy as np
import numpy.typing as npt
from polars import DataFrame, Expr

__version__: str
DEFAULT_MAX_SIZE: int
DEFAULT_DELTA: float
Precision = Literal["auto", "f32", "f64"]
Values = float | Sequence[float] | npt.NDArray[Any]

class ScaleFamily(str, Enum):
    QUAD = "QUAD"
    K1 = "K1"
    K2 = "K2"
    K2NORM = "K2NORM"
    K3 = "K3"

class SingletonPolicy(str, Enum):
    OFF = "off"
    USE = "use"
    EDGES = "edges"

class TDigest:
    """Modern engine. Use a named constructor; updates return this object."""
    @classmethod
    def from_array(
        cls,
        data: Values = ...,
        delta: float | None = ...,
        *,
        max_size: int = ...,
        scale: ScaleFamily | str = ...,
        singleton_policy: SingletonPolicy | str | None = ...,
        pin_per_side: int | None = ...,
        weights: Values = ...,
        precision: Precision | None = ...,
        f32_mode: bool | None = ...,
        arr: Values = ...,
    ) -> TDigest: ...
    @classmethod
    def from_means_weights(
        cls,
        arr: Values,
        weights: Values,
        delta: float | None = ...,
        *,
        max_size: int = ...,
        scale: ScaleFamily | str = ...,
        singleton_policy: SingletonPolicy | str | None = ...,
        pin_per_side: int | None = ...,
        precision: Precision = ...,
        f32_mode: bool | None = ...,
    ) -> TDigest: ...
    @staticmethod
    def from_bytes(b: bytes) -> TDigest: ...
    @classmethod
    def from_dict(cls, d: dict[str, Any]) -> TDigest: ...
    @classmethod
    def merge_all(cls, digests: TDigest | Iterable[TDigest]) -> TDigest: ...
    @property
    def means(self) -> npt.NDArray[np.float64]: ...
    @property
    def weights(self) -> npt.NDArray[np.float64]: ...
    @property
    def count(self) -> float: ...
    @property
    def sum(self) -> float: ...
    @property
    def min(self) -> float: ...
    @property
    def max(self) -> float: ...
    @property
    def max_size(self) -> int: ...
    @property
    def scale(self) -> str: ...
    @property
    def delta(self) -> float | None: ...
    def __len__(self) -> int: ...
    def inner_kind(self) -> Literal["f32", "f64"]: ...
    @overload
    def cdf(self, x: float) -> float: ...
    @overload
    def cdf(self, x: list[float]) -> list[float]: ...
    @overload
    def cdf(self, x: tuple[float, ...]) -> tuple[float, ...]: ...
    @overload
    def cdf(self, x: npt.NDArray[Any]) -> float | npt.NDArray[np.float64]: ...
    @overload
    def quantile(self, q: float) -> float: ...
    @overload
    def quantile(self, q: list[float]) -> list[float]: ...
    @overload
    def quantile(self, q: tuple[float, ...]) -> tuple[float, ...]: ...
    @overload
    def quantile(self, q: npt.NDArray[Any]) -> float | npt.NDArray[np.float64]: ...
    def median(self) -> float: ...
    def trimmed_mean(self, lower: float, upper: float) -> float: ...
    def add(self, values: Values) -> TDigest: ...
    def add_weighted(self, values: Values, weights: Values) -> TDigest: ...
    def merge(self, other: TDigest | Iterable[TDigest]) -> TDigest: ...
    def scale_weights(self, factor: float) -> TDigest: ...
    def scale_values(self, factor: float) -> TDigest: ...
    def cast_precision(self, precision: Literal["f32", "f64"]) -> TDigest: ...
    def to_bytes(self, version: Literal[1, 2, 3] | None = ...) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...

def wire_precision(blob: bytes) -> Literal["f32", "f64"]: ...
def infer_column_precision(
    df: DataFrame, col: str, *, sample: int = ..., strict: bool = ...
) -> Literal["f32", "f64"]: ...
def tdigest(
    values: Any,
    max_size: int = ...,
    *,
    scale: ScaleFamily | str = ...,
    precision: Precision = ...,
    singleton_policy: SingletonPolicy | str | None = ...,
    pin_per_side: int | None = ...,
) -> Expr: ...
def cdf(digest: Any, values: Any) -> Expr: ...
def quantile(digest: Any, q: float) -> Expr: ...
def median(digest: Any) -> Expr: ...
def merge_tdigests(digest: Any) -> Expr: ...
def add_values(digest: Any, values: Any) -> Expr: ...
def add_weighted_values(digest: Any, values: Any, weights: Any) -> Expr: ...
def cast_precision(digest: Any, *, precision: Literal["f32", "f64"]) -> Expr: ...
def scale_weights(digest: Any, factor: float) -> Expr: ...
def scale_values(digest: Any, factor: float) -> Expr: ...
def to_bytes(digest: Any, *, version: Literal[1, 2, 3] | None = ...) -> Expr: ...
def from_bytes(blob: Any, *, precision: Literal["f32", "f64"]) -> Expr: ...
